{
  "name": "upi-guard",
  "version": "1.3.0",
  "private": true,
  "description": "UPI Guard: AI Detection of Creative Payment Frauds - Challenge CC6-AI02",
  "scripts": {
    "generate-data": "python download_and_generate_dataset.py",
    "train": "python train.py",
    "evaluate": "python evaluate.py",
    "server": "python server.py",
    "start": "python server.py",
    "start:node": "node server.cjs",
    "check": "node --check dist/app.js && node --check dist/api-client.js",
    "build:site": "node scripts/build-worker.cjs",
    "test:backend": "python -m unittest test_backend -v",
    "test:gateway": "node test-gateway.mjs",
    "test:qa": "node qa-connected.cjs"
  }
}
